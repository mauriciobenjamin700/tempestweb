{
  "openapi": "3.1.0",
  "info": {
    "title": "Gen API Fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/api/catalog/items": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "list_items",
        "summary": "List the catalogue items visible to the caller.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "catalog"
        ],
        "operationId": "create_item",
        "summary": "Create one catalogue item.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ItemCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/items/{item_id}": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "get_item",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "Primary key of the catalogue item."
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "catalog"
        ],
        "operationId": "patch_item",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Item"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "catalog"
        ],
        "operationId": "delete_item",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/catalog/items/{item_id}/related": {
      "get": {
        "tags": [
          "catalog"
        ],
        "operationId": "list_related_items",
        "parameters": [
          {
            "name": "item_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Item"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/reporting/organisations/{organisation_id}/monthly-summary": {
      "get": {
        "tags": [
          "reporting summaries"
        ],
        "operationId": "fetchOrganisationMonthlySummary",
        "summary": "Return the aggregated monthly summary of one organisation.",
        "parameters": [
          {
            "name": "organisation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganisationMonthlySummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/reporting/acknowledge": {
      "post": {
        "tags": [
          "reporting summaries"
        ],
        "operationId": "acknowledge",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Acknowledgement"
                }
              }
            }
          }
        }
      }
    },
    "/api/webhooks/ping": {
      "get": {
        "tags": [
          "webhooks"
        ],
        "operationId": "ping",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "webhooks"
        ],
        "operationId": "ping",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ItemKind": {
        "type": "string",
        "enum": [
          "physical",
          "digital"
        ]
      },
      "Owner": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Variant": {
        "type": "object",
        "required": [
          "sku",
          "price"
        ],
        "properties": {
          "sku": {
            "type": "string"
          },
          "price": {
            "type": "number"
          }
        }
      },
      "Item": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "createdAt": {
            "type": "string"
          },
          "class": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Owner"
              },
              {
                "type": "null"
              }
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Variant"
            }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "ItemCreate": {
        "type": "object",
        "required": [
          "name",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/ItemKind"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Owner"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ItemPage": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "total": {
            "type": "integer"
          },
          "next_cursor": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "RevenueBreakdownEntry": {
        "type": "object",
        "required": [
          "category",
          "amount"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "OrganisationMonthlySummary": {
        "type": "object",
        "description": "One organisation's aggregated figures for a single month.",
        "required": [
          "organisation_identifier",
          "monthly_revenue_breakdown"
        ],
        "properties": {
          "organisation_identifier": {
            "type": "string"
          },
          "monthly_revenue_breakdown": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RevenueBreakdownEntry"
            }
          },
          "previous_period_summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RevenueBreakdownEntry"
              },
              {
                "type": "null"
              }
            ]
          },
          "comparative_growth_ratio": {
            "type": "number",
            "nullable": true
          }
        }
      },
      "Acknowledgement": {
        "type": "object",
        "properties": {}
      }
    }
  }
}
